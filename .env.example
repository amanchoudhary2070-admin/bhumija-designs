# Copy to .env and edit. Nothing here is required for local development.

# --- Django ---
DJANGO_DEBUG=1
# In production: DJANGO_DEBUG=0 and a long random secret, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
ADMIN_URL=admin/
# Postgres in production: postgres://user:password@host:5432/dbname
DATABASE_URL=
TIME_ZONE=Asia/Kolkata

# --- Your shop ---
SITE_URL=http://localhost:8000
SHOP_NAME=Bhoomija Designs
SHOP_TAGLINE=The Art of Mithila. The Soul of Home.
SHOP_EMAIL=hello@bhoomijadesigns.in
SHOP_PHONE=+91 98765 43210
SHOP_ADDRESS=Darbhanga, Bihar, India
SHOP_OWNER_EMAIL=
SHIPPING_FLAT_RATE=99
FREE_SHIPPING_THRESHOLD=1499
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=
SOCIAL_PINTEREST=
SOCIAL_LINKEDIN=

# --- Payments ---
# "dev"      = built-in fake checkout for local testing (refused when DEBUG is off)
# "razorpay" = real payments: UPI, cards, netbanking and wallets (incl. Paytm)
PAYMENT_PROVIDER=dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (order confirmations). Leave EMAIL_HOST empty to print emails to the console. ---
DEFAULT_FROM_EMAIL=Bhoomija Designs <orders@bhoomijadesigns.in>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
